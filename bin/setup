#!/usr/bin/env node
// lerd sync:setup [site] [--env production] --ssh user@host --path /remote/project
//   [--ssh-port 22] [--url https://example.com] [--files storage/app/public,public/uploads]
//   [--sanitize .lerd/sanitize.sql] [--database name --db-user user --db-password pw --db-host h --db-port p]
// lerd sync:setup [site] --env staging --remove
// Saves where one of this site's servers is; with no options, lists them. The
// database settings are only needed when the server's .env or wp-config.php
// does not carry them.
const { parseArgs } = require('../lib/args');
const { loadConfig, saveConfig, applyEnv } = require('../lib/remote');
const { site: findSite, isWordPress } = require('../lib/lerd');

const FLAGS = { never: 'never', keep: 'keep', backup: 'backup', files: 'files', ssh: 'ssh', path: 'path', 'ssh-port': 'ssh_port', url: 'url', sanitize: 'sanitize', database: 'database', 'db-user': 'db_user', 'db-password': 'db_password', 'db-host': 'db_host', 'db-port': 'db_port' };

function show(name, env) {
  console.log(`[${name}]`);
  for (const [k, v] of Object.entries(env)) console.log(`  ${k.padEnd(12)} ${k === 'db_password' ? '(saved)' : Array.isArray(v) ? v.join(', ') : v}`);
}

(async () => {
  const opts = parseArgs(process.argv.slice(2), ['remove']);
  const site = opts._[0] || process.env.LERD_SITE;
  if (!site) throw new Error('run it inside a linked project, or name the site: lerd sync:setup <site> --ssh user@host --path /remote/project');
  let config = loadConfig(site);
  const changes = Object.keys(opts).filter((k) => k !== '_' && k !== 'env');
  if (!changes.length && !opts.env) {
    const names = Object.keys(config.environments);
    if (!names.length) throw new Error('no server set yet: lerd sync:setup --env production --ssh user@host --path /remote/project');
    for (const n of names) show(n, config.environments[n]);
    return;
  }
  const name = opts.env || 'production';
  if (opts.remove) {
    if (!config.environments[name]) throw new Error(`no ${name} environment to remove`);
    delete config.environments[name];
    saveConfig(site, config);
    console.log(`removed ${name}`);
    return;
  }
  if (opts.scrub !== undefined) {
    if (!['on', 'off'].includes(opts.scrub)) throw new Error(`--scrub is on or off, not ${opts.scrub}`);
    const info = await require('../lib/ops').scrub(site, { env: name, action: `scrub-${opts.scrub}` });
    console.log(info.enabled ? `scrubbing after a pull from ${name}, with ${info.path}; edit it to fit your tables` : `no scrub after a pull from ${name}; ${info.path} is kept`);
    if (Object.keys(opts).filter((k) => !['_', 'env', 'scrub'].includes(k)).length === 0) return;
    config = loadConfig(site); // scrub saved its change; build on it
  }
  const fields = {};
  for (const [flag, key] of Object.entries(FLAGS)) if (opts[flag] !== undefined) fields[key] = opts[flag];
  if (fields.url && !isWordPress(await findSite(site))) throw new Error('--url rewrites WordPress addresses, and this site is not WordPress');
  const env = applyEnv(config, name, fields);
  saveConfig(site, config);
  show(name, env);
})().catch((e) => {
  console.error(e.message);
  process.exit(1);
});
