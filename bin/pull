#!/usr/bin/env node
// lerd sync:pull [site] [--env production] [--db-only | --files-only | --paths a,b]
// Replaces the site's lerd database with a fresh dump from its server, after a
// snapshot, points its URLs at the local site, runs the project's sanitize SQL
// over it, and syncs the listed folders.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { parseArgs, mcpInput } = require('../lib/args');
const { assertRsync, neverRules, backupDir, backupNote, pruneBackups } = require('../lib/files');
const { site: findSite, lerd, lerdWithInput, siteDatabase, siteUrl, isWordPress } = require('../lib/lerd');
const { loadConfig, pickEnv, engineOf, dumpCommand, passwordInput, ssh, sshArgs, remoteDatabase, mariadbToMysql, rewriteFile } = require('../lib/remote');

async function pullDatabase(site, config) {
  const service = (site.services || []).find((s) => engineOf(s));
  if (!service) throw new Error(`${site.name} uses no MySQL or PostgreSQL service in lerd`);
  const database = siteDatabase(site);
  const engine = engineOf(service);
  const db = remoteDatabase(config);

  const tmp = path.join(process.env.LERD_PLUGIN_DATA, 'tmp');
  fs.mkdirSync(tmp, { recursive: true });
  const file = path.join(tmp, `${site.name}.sql`);
  console.log(`dumping ${db.database} on ${config.ssh}`);
  try {
    const fd = fs.openSync(file, 'w', 0o600);
    try {
      ssh(config, dumpCommand(engine, db), fd, passwordInput(db));
    } finally {
      fs.closeSync(fd);
    }
    if (fs.statSync(file).size === 0) throw new Error('the server returned an empty dump; nothing was imported');
    if (/^mysql(-|$)/.test(service)) await rewriteFile(file, mariadbToMysql);
    lerd(['db:create', database, '-s', service], site.path);
    lerd(['db:snapshot', 'before-sync-pull', '-s', service, '-d', database], site.path);
    lerd(['db:import', file, '--fresh', '-s', service, '-d', database], site.path);
  } finally {
    fs.rmSync(file, { force: true });
  }
  // A WordPress database names its own address in options and content, so
  // without this the local copy redirects to the server.
  if (config.url && isWordPress(site)) {
    console.log(`replacing ${config.url} with ${siteUrl(site)}`);
    lerd(['wp', 'search-replace', config.url, siteUrl(site), '--all-tables', '--skip-columns=guid', '--report-changed-only'], site.path);
  }
  if (config.sanitize) {
    const sql = path.join(site.path, config.sanitize);
    if (!fs.existsSync(sql)) throw new Error(`the sanitize file ${config.sanitize} is missing from ${site.path}`);
    console.log(`running ${config.sanitize}`);
    // Through db:shell rather than db:import, which only warns when statements
    // fail: a sanitize step that half ran must stop the pull, not report success.
    // psql carries on past errors unless told otherwise.
    const stop = engine === 'postgres' ? '\\set ON_ERROR_STOP on\n' : '';
    try {
      lerdWithInput(['db:shell', '-s', service, '-d', database], site.path, stop + fs.readFileSync(sql, 'utf8'));
    } catch {
      throw new Error(`${config.sanitize} failed, so the pulled database may still hold unscrubbed data`);
    }
  }
}

function pullFiles(site, config) {
  if ((config.files || []).length) assertRsync();
  const keep = backupDir('pull', config, site.name);
  for (const dir of config.files || []) {
    console.log(`syncing ${dir}/`);
    fs.mkdirSync(path.join(site.path, dir), { recursive: true });
    // No --delete: a file only the local copy has is left alone.
    const backup = keep ? ['--backup', `--backup-dir=${keep}/${dir}`] : [];
    const r = spawnSync('rsync', ['-az', '--protect-args', '--safe-links', ...backup, ...neverRules(config).map((r) => `--exclude=${r}`), '-e', ['ssh', ...sshArgs(config)].join(' '), `${config.ssh}:${config.path}/${dir}/`, path.join(site.path, dir) + '/'], {
      stdio: ['ignore', 'inherit', 'inherit'],
    });
    if (r.error) throw r.error;
    if (r.status !== 0) throw new Error(`rsync of ${dir} failed`);
  }
  const note = backupNote('pull', config, keep);
  if (note) console.log(note);
  pruneBackups('pull', config, keep);
}

// Just the named files and folders, the way the Sync tab pulls a selection.
async function pullPaths(name, config, paths) {
  const list = Array.isArray(paths) ? paths : String(paths).split(',').map((p) => p.trim()).filter(Boolean);
  const r = await require('../lib/ops').transfer(name, { direction: 'pull', env: config.name, paths: list });
  console.log(r.log);
  if (!r.ok) process.exit(1);
}

(async () => {
  const input = mcpInput();
  const opts = input ? { _: [input.site], env: input.env, paths: input.paths, 'db-only': input.what === 'db', 'files-only': input.what === 'files' } : parseArgs(process.argv.slice(2), ['db-only', 'files-only']);
  const name = opts._[0] || process.env.LERD_SITE;
  if (!name) throw new Error('usage: lerd sync:pull [site] [--env name] [--db-only | --files-only], or run it inside a linked project');
  // The Commands menu cannot ask which environment, so it takes production, or the first.
  const config = pickEnv(loadConfig(name), opts.env, { preferProduction: process.env.LERD_SURFACE === 'site_command' });
  if (opts.paths) return pullPaths(name, config, opts.paths);
  const site = await findSite(name);
  if (!opts['files-only']) await pullDatabase(site, config);
  if (!opts['db-only']) pullFiles(site, config);
  console.log(`${name}: pulled from ${config.name} (${config.ssh})`);
})().catch((e) => {
  console.error(e.message);
  process.exit(1);
});
