#!/usr/bin/env node
// The Sync tab's endpoints. GET answers the environments, a listing, a count,
// a file or the backups; POST saves an environment or runs an action.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { loadConfig, saveConfig, applyEnv, publicConfig, pickEnv } = require('../lib/remote');
const { site: findSite, isWordPress } = require('../lib/lerd');
const ops = require('../lib/ops');

// Runs bin/pull or bin/push and hands back what it printed, so the tab shows
// the same lines a terminal would, failure included.
function runCommand(cmd, args) {
  const r = spawnSync(path.join(process.env.LERD_PLUGIN_DIR, 'bin', cmd), args, { encoding: 'utf8', maxBuffer: 16 << 20 });
  return { ok: r.status === 0, log: `${r.stdout || ''}${r.stderr || ''}`.trim() };
}

async function run(site, body) {
  if (body.action === 'transfer') return ops.transfer(site, body);
  if (body.action === 'restore') return ops.restore(site, body);
  if (body.action === 'remove-backup') return ops.removeBackup(site, body);
  const env = pickEnv(loadConfig(site), body.env, { required: true });
  if (body.action === 'test') return ops.testConnection(env);
  if (body.action === 'pull') {
    const only = { db: ['--db-only'], files: ['--files-only'] }[body.what] || [];
    return runCommand('pull', [site, '--env', env.name, ...only]);
  }
  if (body.action === 'push') {
    if (body.what === 'db') {
      // The tab asked for the environment's name typed back before sending this.
      if (body.confirm !== env.name) throw new Error('a database push needs the environment name confirmed');
      return runCommand('push', [site, '--env', env.name, '--db', '--yes']);
    }
    return runCommand('push', [site, '--env', env.name, ...(body.dry_run ? ['--dry-run'] : [])]);
  }
  throw new Error(`unknown action ${body.action}`);
}

(async () => {
  const q = new URLSearchParams(process.env.LERD_QUERY || '');
  // Only a site lerd itself found; an unknown name in the query is never used.
  const site = process.env.LERD_SITE;
  if (!site) throw new Error('site is required and must be a lerd site');
  const opts = { env: q.get('env'), dir: q.get('dir'), all: q.get('all') === '1', side: q.get('side'), file: q.get('file'), backup: q.get('backup'), id: q.get('id'), paths: JSON.parse(q.get('paths') || '[]') };
  if (process.env.LERD_METHOD !== 'POST') {
    if (q.get('backups')) return console.log(JSON.stringify(q.get('id') ? await ops.backupFiles(site, opts) : await ops.backups(site, opts)));
    if (q.get('count')) return console.log(JSON.stringify(await ops.count(site, opts)));
    if (q.get('file')) return console.log(JSON.stringify(await ops.fileVersions(site, opts)));
    console.log(JSON.stringify(q.get('dir') !== null ? await ops.listing(site, opts) : { ...publicConfig(loadConfig(site)), local: await ops.localInfo(site) }));
    return;
  }
  const body = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
  if (body.action === 'save-env' || body.action === 'remove-env') {
    const config = loadConfig(site);
    if (body.action === 'remove-env') {
      if (!config.environments[body.env]) throw new Error(`no ${body.env} environment`);
      delete config.environments[body.env];
    } else {
      // A typo in the form is the user's to fix, not the plugin failing.
      try {
        if (body.fields?.url && !isWordPress(await findSite(site))) throw new Error('the site address rewrites WordPress addresses, and this site is not WordPress');
        applyEnv(config, body.env, body.fields || {});
      } catch (e) {
        console.log(JSON.stringify({ error: e.message }));
        return;
      }
    }
    saveConfig(site, config);
    console.log(JSON.stringify(publicConfig(config)));
    return;
  }
  console.log(JSON.stringify(await run(site, body)));
})().catch((e) => {
  console.error(e.message);
  process.exit(1);
});
